# ============================================================================
# BaanMitra — ALL FREE TIERS. No credit card is required for any of these.
# Copy this file to .env and fill in what you have.
# ============================================================================

# ---- Free tier #1: Groq (LLM + Whisper STT, no card) -----------------------
# https://console.groq.com/keys  — sign up with email only
GROQ_API_KEY=

# ---- Free tier #2: Supabase (PostgreSQL 15 + PostGIS, no card) -------------
# https://supabase.com → new project → Settings → Database → Connection string
DATABASE_URL=

# ---- Free tier #3: Upstash (Redis, no card) --------------------------------
# https://upstash.com → free Redis → copy the rediss:// URL
REDIS_URL=

# ---- Free tier #4: Bhashini (Assamese / Bodo / Bengali TTS, free, govt) ----
# https://bhashini.gov.in → register → API key. Leave blank to use fallbacks.
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# ---- Optional: ttsfree.in (free 200 credits/month, AI4Bharat Parler-TTS) ---
TTSFREE_API_KEY=

# ---- Optional fallback LLM: Google AI Studio (no card) --------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Free tier #5: Twilio trial (calls + WhatsApp sandbox, no card) ---------
# https://twilio.com/try-twilio — trial balance included.
# TRIAL LIMITS: only verified numbers may be called; messages get a
# "Twilio trial" prefix. Put your teammates here.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
TWILIO_TRIAL=true

# Comma-separated E.164 numbers the agent is allowed to dial.
# The watchdog REFUSES to call anything not in this list.
CONSENTED_NUMBERS=+911234567890,+919876543210

# Public URL of this service (used for Twilio webhooks + serving audio)
PUBLIC_BASE_URL=http://localhost:8000

# Shared secret for the /cron/ingest endpoint (any random string)
CRON_TOKEN=change-me

# ---- Model selection (free Groq models) -----------------------------------
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3
